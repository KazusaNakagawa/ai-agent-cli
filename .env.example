# Required for `local_llm.sh --briefing` (Brave Search pre-fetch).
# Get a Free-plan key at https://api-dashboard.search.brave.com/
BRAVE_API_KEY=your_brave_search_api_key_here
# Required for `briefing_api.sh` (Claude API cost-verification spike, #204).
# Metered pay-as-you-go, separate from the Claude Code subscription.
# Get a key at https://console.anthropic.com/ (or store it in the macOS Keychain).
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CHANNEL_ID=your_channel_id_here
CLAUDE_MODEL=
DISCORD_TOKEN=your_discord_bot_token_here
NOTION_API_KEY=your_notion_integration_token_here
NOTION_DATABASE_ID=your_notion_database_id_here
