<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aiagent.run</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/nakagawakazusa/work/ai-agent/bin/run.sh</string>
    </array>

    <!-- 毎朝 8:00 に実行 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/nakagawakazusa/work/ai-agent/log/launchd.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/nakagawakazusa/work/ai-agent/log/launchd.stderr.log</string>

    <!-- ログイン済みセッションのみ実行（GUI ログインが必要な環境変数対策） -->
    <key>SessionCreate</key>
    <true/>

    <!-- スリープ中にトリガーが過ぎたら復帰後に即実行 -->
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
